# Selected content and disposable search state
WIKI_DIR=
WIKI_FTS_DB=

# MCP process
MCP_SCOPE=public
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=9320
MCP_HTTP_PATH=/mcp
MCP_ALLOWED_HOSTS=
MCP_BEARER_TOKEN=

# Optional PM2 example overrides
BUN_BIN=bun
MCP_PUBLIC_PROCESS_NAME=llm-wiki-mcp-public
MCP_PUBLIC_HOST=127.0.0.1
MCP_PUBLIC_PORT=9320
MCP_PUBLIC_ALLOWED_HOSTS=
MCP_ADMIN_PROCESS_NAME=llm-wiki-mcp-admin
MCP_ADMIN_HOST=127.0.0.1
MCP_ADMIN_PORT=9321
MCP_ADMIN_ALLOWED_HOSTS=

# Required only for readonly admin HTTP
MCP_OAUTH_ISSUER=
MCP_OAUTH_RESOURCE=
MCP_OAUTH_DB=
MCP_OAUTH_OWNER_USERNAME=
MCP_OAUTH_PASSWORD_HASH_FILE=
MCP_OAUTH_PRIVATE_KEY_FILE=
MCP_OAUTH_PUBLIC_KEY_FILE=
MCP_OAUTH_SCOPES=mcp:admin

# Optional Hermes factcheck
HERMES_BIN=hermes
HERMES_PROFILE=factchecker
HERMES_SKILL=wiki/factcheck-wiki
FACTCHECK_TIMEOUT_BIN=timeout
FACTCHECK_BATCH_SIZE=5
FACTCHECK_MAX_BATCHES_PER_RUN=1
FACTCHECK_TIMEOUT_SEC=720
FACTCHECK_TIMEOUT_KILL_AFTER_SEC=30
FACTCHECK_MAX_RETRIES=2
FACTCHECK_RUNNING_STALE_MINUTES=
FACTCHECK_FULL=0
FACTCHECK_PRINT_NOOP=0
FACTCHECK_AUTO_COMMIT=0
FACTCHECK_STATE_FILE=
FACTCHECK_LOG_FILE=
FACTCHECK_STAMP_FILE=
