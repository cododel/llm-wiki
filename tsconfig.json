{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowImportingTsExtensions": true, "types": ["bun-types"], "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
